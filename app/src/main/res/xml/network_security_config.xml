<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The streams and CDN assets are https; allow cleartext only as a safety
         net for legacy CDN redirects so playback never dies on a http hop. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
